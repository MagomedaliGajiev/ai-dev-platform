.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Local agent settings; project instructions and skills stay versioned.
.claude/settings.local.json
CLAUDE.local.md

# Generated output, logs, and temporary files
/dist/
/build/
/out/
coverage/
playwright-report/
test-results/
*.log
/tmp/
/temp/
